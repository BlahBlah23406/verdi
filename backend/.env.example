# Set server environment or use a private JSON via --config. Never put keys in Flutter.
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
# A previously consented Plaid Link account. Sandbox first.
PLAID_ENV=sandbox
PLAID_USER=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
# Background sync (off unless 1). Live mode only; never runs in --demo.
VERDI_SYNC_ENABLED=
VERDI_SYNC_INTERVAL_SECONDS=3600
VERDI_SYNC_MAX_BACKOFF_SECONDS=21600
